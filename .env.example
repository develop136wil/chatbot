# Supabase Configuration
SUPABASE_URL="your-supabase-url"
SUPABASE_KEY="your-supabase-server-secret-key"
# Server-only key for the protected response-cache tables (service_role or sb_secret_...).
SUPABASE_CACHE_KEY="your-supabase-service-key"

# AI Models (Gemini & Groq)
GEMINI_API_KEYS="your-free-project-key"  # 무료 전용 모드는 첫 번째 키만 사용
GROQ_API_KEY="your-groq-key"
# Groq Free Plan models. Keep model IDs configurable so retirements do not require code changes.
GROQ_FAST_MODEL="openai/gpt-oss-20b"
GROQ_QUALITY_MODEL="openai/gpt-oss-120b"
# Free-tier safety (defaults are also enforced in code).
# Put only a billing-free Gemini project's key first. Extra Gemini keys are ignored.
FREE_TIER_ONLY="true"
FREE_TIER_DAILY_REQUESTS_PER_SESSION="30"
FREE_TIER_MAX_OUTPUT_TOKENS="400"
FREE_TIER_TRANSLATION_MAX_TOKENS="4096"
# 20260919_runtime_safety.sql 적용 필수. 대화+인덱싱이 함께 쓰는 하루 작업 단위.
# 공급자별 RPM/TPM/결제 여부와는 별개이며 0원 과금을 보장하는 설정이 아닙니다.
SHARED_AI_BUDGET_ENABLED="true"
AI_DAILY_GLOBAL_LIMIT="100"
AI_DAILY_CLIENT_LIMIT="30"
ALLOW_FREE_TIER_GROQ_FALLBACK="true"
ALLOW_LIVE_TRANSLATION="false"
# Exact response cache stored in Supabase (run supabase/20260730_response_cache.sql first).
ENABLE_RESPONSE_CACHE="true"
# Cache freshness is checked against changed Notion categories; this is retention/cleanup only.
CHAT_RESPONSE_CACHE_TTL_SECONDS="7776000"

# Notion Configuration
NOTION_API_KEY="your-notion-secret"
NOTION_DB_CARE="care-db-id"
NOTION_DB_EDUCATION="education-db-id"
NOTION_DB_FAMILY="family-db-id"
NOTION_DB_LIFE="living-db-id"
NOTION_DB_MEDICAL="medical-db-id"
NOTION_FEEDBACK_DB_ID="feedback-db-id"
NOTION_LOG_DB_ID="log-db-id"
# 질문 원문을 Notion에 별도 기록할지 여부입니다. 개인정보 보호를 위해 기본값은 false입니다.
ENABLE_NOTION_QUERY_LOGS="false"

# Security
ADMIN_SECRET_KEY="your-strong-admin-password"
SESSION_SECRET_KEY="your-complex-session-secret"
ADDITIONAL_CORS_ORIGIN="https://your-custom-domain.com"
ENABLE_DEBUG_ENDPOINT="false"
# Gemini 임베딩 외부 호출이 응답하지 않을 때 무한 대기를 막는 시간(초)
GEMINI_EMBEDDING_TIMEOUT_SECONDS="15"

# Redis is optional. Vercel's current synchronous mode intentionally does not use it.
REDIS_URL="rediss://your-redis-url"
